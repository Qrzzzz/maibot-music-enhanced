{
  "manifest_version": 2,
  "id": "github.qrzzzz.music-enhanced",
  "version": "1.0.0",
  "name": "麦麦点歌增强",
  "description": "基于 maibot-music 增强的 QQ/网易云点歌插件，支持聚合音源、完整时长校验、转码和本地语音缓存",
  "author": {
    "name": "Qrzzzz",
    "url": "https://github.com/Qrzzzz"
  },
  "license": "GPL-3.0-only",
  "urls": {
    "repository": "https://github.com/Qrzzzz/maibot-music-enhanced",
    "issues": "https://github.com/Qrzzzz/maibot-music-enhanced/issues"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.15"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.16.0"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    },
    {
      "type": "python_package",
      "name": "cryptography",
      "version_spec": ">=42.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
